#!/usr/bin/env python3
"""The reporting decision for a red CI run on `main`: the red jobs, the milestone and the area label.

`scripts/nightly-issue.sh` reads the run's jobs (and the open milestones, and one log per red job)
through the GitHub API and owns the `gh` calls; this file owns what the reporter decides from those
documents, so the decision is pure and its self-test needs no network. It mirrors
`scripts/ci-ok-state`.

- `--jobs-json FILE --run-url URL` prints `id<TAB>name` for every red job. A job that did not run
  (skipped) is not a failure; only a conclusion that means the job ran and did not pass is. A job that
  never started is not a red job either: GitHub concludes a job it never acquired a runner for as
  `cancelled`, with `runner_id: 0` and an empty step list ("The job was not acquired by Runner of type
  hosted even after multiple attempts"), so it prints nothing for that job and names it on stderr
  instead, with the run link, because no change in this repository can fix it and the remedy is a
  rerun. All three have to hold: a job cancelled by a superseding run also has no steps, and a started
  job can still report `runner_id: 0`. A job cancelled after it reached a step, and any document whose
  `steps` list or `runner_id` is missing, stays red: the rule fails closed. The run link is required with
  the jobs because the reporter names the job and the run, never the job alone. The two jobs whose result
  is derived from the others' (`ci-ok` and `red-main-issue`) are not printed beside a red job that ran:
  their card would name no failure of its own, because the leg's card is the finding and the aggregate only
  restates it (#1002). Such a job is named on stderr with the run link instead. A run whose only red jobs
  that ran are the derived ones still prints them: then nothing else in the run speaks for the gate, and a
  wrong aggregate verdict is the whole finding. Whether the aggregate's record is in the document at the
  read no longer changes the card set, only that line: the reporter does not depend on `ci-ok`, so the
  record is there only when the aggregate happened to finish first.
- `--abandoned-json FILE` prints `id<TAB>name` for the red jobs that never acquired a runner, without the
  two jobs whose result is derived from the others' (`ci-ok` and `red-main-issue`). That is the list the
  run's job summary names, and the list no card is ever filed for (#922, #923).
- `--capacity-json FILE` prints `capacity` when every red job of the run was cancelled before it reached a
  machine, and nothing otherwise. That is the red no code can fix, so the pipeline retries it instead of
  reporting it. One red job that ran makes the run an ordinary red.
- `--milestones-json FILE` prints the lowest open milestone whose title is a version
  (`MAJOR.MINOR.PATCH`), compared numerically. `backlog` and any other title never match, and a release
  that closes its milestone removes it from the open list, so no constant names a version here. The list
  endpoint answers both a bare list and `gh api --paginate --slurp`'s list of pages, where each page of a
  list endpoint is itself a list.
- `--failed-step-json FILE --job-id ID` prints the name of the job's first step that did not succeed, or
  nothing when the document holds no such step. It is what the card names so a session starts at the step
  that failed instead of spending its first call on the run's jobs document (#945).
- `--failed-tests-file FILE` prints the fully-qualified names of the tests the job logged as failed, one
  per line, in log order: the same list the area label is derived from, which the card names.
- `--log-file FILE --source-root DIR` prints one area label from the failing tests the job logged, or
  nothing when the project does not decide it.

The area label is derived from the failing test's project, not from the red job: a test in
`Lunate.Tui.Tests` is `area/tui`, and a test in `Lunate.Coding.Tests` is `area/tui` when the test's own
source names the `Lunate.Tui` namespace and `area/core` otherwise. That second step is what keeps
`InteractiveSessionThemeFileTests` and the repaint tests — TUI material inside the coding test project —
out of `area/core`. A red job that names no failing test (a build, format, perf or PowerShell leg), a
test in a project outside those two, or any failing test the project cannot classify prints nothing
rather than a guess, even when the other failing tests agree.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

RED = {"failure", "timed_out", "cancelled", "action_required", "startup_failure"}
VERSION = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")
# GitHub Actions makes the test runner color its output even into a redirected file, so a logged failure
# arrives as `\x1b[31mfailed\x1b[m <test>`. The gate's readers strip the escapes before matching
# (`strip_ansi` in scripts/lib.sh); this one reads a job log the gate does not write, so it strips its
# own -- without it every card of a red macOS leg named no test and carried no area label (#954).
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
# The gate's test runner already reads these lines in `scripts/verify-test-runner.ps1`.
FAILED_TEST = re.compile(r"^\s*(?:(?i:failed)|\[FAIL\]|xunit\.v3[^ ]* failed)\s+(\S+)")
# The two test projects whose failures decide an area, and the default before the TUI check.
TUI_PROJECT = "Lunate.Tui.Tests"
CODING = "Lunate.Coding.Tests"


def _records(data, key):
    """The records of a GitHub list endpoint: an object with `key`, a `--paginate --slurp` page list, or a bare list."""
    if isinstance(data, dict):
        return list(data.get(key) or [])
    if isinstance(data, list):
        records = []
        for page in data:
            if isinstance(page, list):
                # A slurped list endpoint pages an array per page: milestones arrives as `[[...], [...]]`.
                records.extend(page)
            elif isinstance(page, dict) and isinstance(page.get(key), list):
                records.extend(page[key])
            elif isinstance(page, dict):
                records.append(page)
        return records
    return []


def _load(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def red_jobs(path, run_url):
    """One `id<TAB>name` line per red job, in the order the run lists them, without duplicates."""
    jobs = _red_jobs(path)
    # A derived job restates the result of a red job that ran, so beside one its card would name no
    # failure of its own. When nothing else of the run is red, it is the finding and still files.
    restated = any(not _derived(job) and not _never_acquired(job) for job in jobs)
    seen = set()
    for job in jobs:
        name = str(job.get("name") or "").strip()
        if not name or name in seen:
            continue
        seen.add(name)
        if _never_acquired(job):
            print(
                f"ci-issue-triage: {name}: never started (no runner was acquired); "
                f"no card is filed for it; rerun {run_url}",
                file=sys.stderr,
            )
            continue
        if restated and _derived(job):
            print(
                f"ci-issue-triage: {name}: only restates the jobs that ran; "
                f"no card is filed for it; run {run_url}",
                file=sys.stderr,
            )
            continue
        print(f"{job.get('id') or ''}\t{name}")


def abandoned_jobs(path):
    """One `id<TAB>name` line per red job that never acquired a runner, minus the two derived jobs."""
    seen = set()
    for job in _red_jobs(path):
        name = str(job.get("name") or "").strip()
        if not name or name in seen or _derived(job) or not _never_acquired(job):
            continue
        seen.add(name)
        print(f"{job.get('id') or ''}\t{name}")


def _red_jobs(path):
    """The red job records of the run, in the order the payload lists them."""
    return [job for job in _records(_load(path), "jobs") if str(job.get("conclusion") or "") in RED]


# The two jobs whose result is derived from the others': the aggregate gate fails because a required leg
# did not succeed, and the reporter fails because it deferred a capacity red to the retry. Neither carries
# coverage of its own, so they never make a run an ordinary red beside the abandoned legs, and neither is
# named as an abandoned leg (#923).
DERIVED_JOBS = {"ci-ok", "red-main-issue"}


def _never_acquired(job):
    """A job GitHub cancelled before it reached a machine: no runner assigned, a present and empty step list."""
    if str(job.get("conclusion") or "") != "cancelled":
        return False
    runner = job.get("runner_id")
    # A missing runner is not evidence of anything, and `False == 0` in Python, so check the type.
    if isinstance(runner, bool) or not isinstance(runner, int) or runner != 0:
        return False
    steps = job.get("steps")
    # A missing list is not evidence that nothing ran, so only a present and empty one counts.
    return isinstance(steps, list) and not steps


def _derived(job):
    """A job that only restates the other jobs' results: the aggregate gate and the reporter."""
    return str(job.get("name") or "").strip() in DERIVED_JOBS


def capacity_red(path):
    """`capacity` when the run is red only because no runner was acquired, so a retry is the report."""
    reds = _red_jobs(path)
    if not reds:
        return
    if not any(_never_acquired(job) for job in reds):
        return
    if all(_never_acquired(job) or _derived(job) for job in reds):
        print("capacity")


def lowest_version_milestone(path):
    """The lowest open `MAJOR.MINOR.PATCH` milestone title, or nothing."""
    versions = []
    for milestone in _records(_load(path), "milestones"):
        title = str(milestone.get("title") or "").strip()
        match = VERSION.match(title)
        if match:
            versions.append((tuple(int(part) for part in match.groups()), title))
    if versions:
        print(min(versions)[1])


def failed_step(path, job_id):
    """The name of the job's first step that did not succeed, or nothing."""
    for job in _records(_load(path), "jobs"):
        if str(job.get("id") or "") != str(job_id):
            continue
        for step in job.get("steps") or []:
            name = str(step.get("name") or "").strip()
            if name and str(step.get("conclusion") or "") in RED:
                return name
        return None
    return None


def failing_tests(path):
    """The fully-qualified names of the tests the job logged as failed, in log order."""
    tests = []
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                match = FAILED_TEST.match(ANSI.sub("", line))
                if not match:
                    continue
                # A theory's name carries its arguments: `Method(1, "x")`.
                name = match.group(1).split("(", 1)[0]
                if name and name not in tests:
                    tests.append(name)
    except OSError:
        return []
    return tests


def _test_projects(source_root):
    tests = source_root / "tests"
    if not tests.is_dir():
        return []
    # Longest name first, so `Lunate.Coding.Tests` wins over a shorter prefix.
    return sorted(
        (entry.name for entry in tests.iterdir() if entry.is_dir()),
        key=len,
        reverse=True,
    )


def _project_of(fqn, projects):
    for project in projects:
        if fqn == project or fqn.startswith(project + "."):
            return project
    return ""


def _class_of(fqn, project):
    rest = fqn[len(project) :].lstrip(".")
    parts = [part for part in rest.split(".") if part]
    # `Namespace.Class.Method` is the shape: the class is the segment before the method.
    return parts[-2] if len(parts) >= 2 else ""


def _class_source(project_dir, class_name):
    pattern = re.compile(r"\bclass\s+" + re.escape(class_name) + r"\b")
    for path in sorted(project_dir.rglob("*.cs")):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if pattern.search(text):
            return text
    return None


def _area_of(fqn, source_root, projects):
    project = _project_of(fqn, projects)
    if project == TUI_PROJECT:
        return "area/tui"
    if project != CODING:
        return ""
    class_name = _class_of(fqn, project)
    if not class_name:
        return ""
    source = _class_source(source_root / "tests" / project, class_name)
    if source is None:
        return ""
    return "area/tui" if re.search(r"\bLunate\.Tui\b", source) else "area/core"


def area_label(log_path, source_root):
    """The one area label the job's failing tests agree on, or nothing when any test is unclassifiable."""
    projects = _test_projects(source_root)
    labels = set()
    for fqn in failing_tests(log_path):
        label = _area_of(fqn, source_root, projects)
        if not label:
            return
        labels.add(label)
    if len(labels) == 1:
        print(labels.pop())


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--jobs-json")
    parser.add_argument("--run-url")
    parser.add_argument("--abandoned-json")
    parser.add_argument("--capacity-json")
    parser.add_argument("--milestones-json")
    parser.add_argument("--failed-step-json")
    parser.add_argument("--job-id")
    parser.add_argument("--failed-tests-file")
    parser.add_argument("--log-file")
    parser.add_argument("--source-root")
    args = parser.parse_args(argv)

    if args.jobs_json:
        if not args.run_url:
            parser.error("--jobs-json needs --run-url")
        red_jobs(args.jobs_json, args.run_url)
        return 0
    if args.abandoned_json:
        abandoned_jobs(args.abandoned_json)
        return 0
    if args.capacity_json:
        capacity_red(args.capacity_json)
        return 0
    if args.milestones_json:
        lowest_version_milestone(args.milestones_json)
        return 0
    if args.failed_step_json:
        if not args.job_id:
            parser.error("--failed-step-json needs --job-id")
        step = failed_step(args.failed_step_json, args.job_id)
        if step:
            print(step)
        return 0
    if args.failed_tests_file:
        for name in failing_tests(args.failed_tests_file):
            print(name)
        return 0
    if args.log_file:
        if not args.source_root:
            parser.error("--log-file needs --source-root")
        area_label(args.log_file, Path(args.source_root))
        return 0
    parser.error(
        "one of --jobs-json, --abandoned-json, --capacity-json, --milestones-json, "
        "--failed-step-json, --failed-tests-file or --log-file is required"
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
