<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Lunate.Ai.Decisions</RootNamespace>
        <IsPackable>false</IsPackable>
        <!--
            Carried inside the `Lunate.Agent` package through the harness, so it follows that
            package's target frameworks (ADR-0041).
        -->
        <!--
            `TargetFrameworks` selects a cross-targeting build only when `TargetFramework` is
            empty, and Directory.Build.props sets it for every project: clear the inherited value
            here, or the project silently builds the first framework alone.
        -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lunate.Agent" />
        <InternalsVisibleTo Include="Lunate.Agent.Tests" />
        <InternalsVisibleTo Include="Lunate.Ai.SystemOne" />
        <InternalsVisibleTo Include="lunate" />
    </ItemGroup>
</Project>
