<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Lunate.Extensibility.Abstractions</RootNamespace>
        <!--
            Both contract assemblies' versions are the API version: ExtensionApiGate compares an
            extension's contract assembly references with ExtensionApi.Current, and the parity test
            (Lunate.Coding.Tests) fails when a bump of one drops the other.
        -->
        <!--
            The extension contract ships stable beside the tool (issue #237): a packaging extension
            header compiles against the package, where the compiled extension then names an apiVersion
            matched by ExtensionApiGate against this version. It is a prerequisite of the
            packaged-extension template, which installs it from NuGet.
        -->
        <Version>$(ContractVersion)</Version>
        <PackageId>Lunate.Extensibility.Abstractions</PackageId>
        <IsPackable>true</IsPackable>
        <Description>
            The extension contract of Lunate: IExtension, IExtensionFactory, the hook catalogue,
            workspace and settings surfaces, IDecisionService and ExtensionApi — the version number
            an extension's apiVersion is judged against at load. The host loads this assembly once
            and every extension binds to that copy, so a copy an extension ships is ignored at load.
        </Description>
        <PackageTags>lunate;extensibility;extension-api</PackageTags>
        <!--
            IDecisionService is typed with the decision layer's model, so this package carries that
            assembly in lib/ beside the contract instead of naming a package dependency on an
            assembly that is not published on its own (ADR-0042). The same shape Lunate.Agent and
            the test kit use for the assemblies they ship.
        -->
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackOwnAssemblies
        </TargetsForTfmSpecificContentInPackage>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>lunate-logo-dark.png</PackageIcon>
        <PackageProjectUrl>https://github.com/lunate-agent/lunate</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lunate-agent/lunate</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="../../assets/brand/lunate-logo-dark.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lunate.Extensibility" />
        <InternalsVisibleTo Include="Lunate.Extensibility.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Lunate.Contracts/Lunate.Contracts.csproj" />
        <!--
            The decision model lives in Lunate.Ai.Decisions (ADR-0042): the edge runs down from the
            decision layer to the contract, and IDecisionService is typed with its request/result
            records. PrivateAssets stops a nuspec dependency on an unpacked assembly and the pack
            target below carries the file.
        -->
        <ProjectReference
            Include="../Lunate.Ai.Decisions/Lunate.Ai.Decisions.csproj"
            PrivateAssets="All"
        />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <Target Name="PackOwnAssemblies">
        <ItemGroup>
            <TfmSpecificPackageFile
                Include="$(OutDir)Lunate.Ai.Decisions.dll"
                PackagePath="lib/$(TargetFramework)"
            />
        </ItemGroup>
    </Target>
</Project>
