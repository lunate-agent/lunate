<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Mermaid.Terminal</RootNamespace>
        <!--
            The renderer ships independently of Lunate: a host that knows nothing about the agent
            can parse a Mermaid fence and draw it. It references no Lunate project, by design
            (ADR-0039), and carries the product version like the other release packages. It keeps a
            net10.0 asset beside the net11.0 one, like the extension packages (ADR-0041).
        -->
        <!--
            `TargetFrameworks` selects a cross-targeting build only when `TargetFramework` is
            empty, and Directory.Build.props sets it for every project: clear the inherited value
            here, or the project silently builds the first framework alone.
        -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>Mermaid.Terminal</PackageId>
        <Description>
            Render Mermaid flowcharts and sequence diagrams to terminal text. A port of the
            MIT-licensed mermaid-ascii layout and drawing, usable without Lunate.
        </Description>
        <PackageTags>mermaid;diagram;terminal;ascii;unicode</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>lunate-logo-dark.png</PackageIcon>
        <PackageProjectUrl>https://github.com/lunate-agent/lunate</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lunate-agent/lunate</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
        <None Include="../../assets/brand/lunate-logo-dark.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Mermaid.Terminal.Tests" />
    </ItemGroup>
</Project>
